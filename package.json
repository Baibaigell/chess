{
  "name": "chess-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "description": "国际象棋、中国象棋、五子棋。人机对战、本地双人、房间码联机。PWA 可安装。",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "build:fast": "node scripts/build.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "sync:android": "node scripts/sync-android.mjs",
    "apk": "node scripts/build.mjs && node scripts/sync-android.mjs",
    "start": "node server/server.js",
    "preview": "node server/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-chess/chessground": "^1.3.4",
    "chess.js": "^1.0.0",
    "chessground": "^8.3.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stockfish": "^19.0.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
